# Exclude development files and folders
.vscode/
.vscode-test/
node_modules/
.zcode/
.claude/
_dbg/
svg_temp/

# Source code and test files that are compiled
src/
test/

# Python specific ignores
.venv/
backend/**/__pycache__/
**/__pycache__/
backend/tests/
.pytest_cache/

# Test artifacts
test_output/
test.html
test.svg

# Exclude build artifacts
*.vsix
**/*.map

# Exclude project configuration (not needed at runtime)
.gitignore
.gitattributes
package-lock.json
tsconfig.json
.github/

# Exclude large bundled dependencies — downloaded on-demand to user cache
# (see backend/resource_manager.py)
tools/plantuml.jar
tools/poppler/
tools/batik-lib/

# Include important documentation files
!README.md
!README_zh.md
!CHANGELOG.md
!LICENSE
